# =============================================================
# Environment variables for the portfolio contact form (Resend)
# Copy this file to ".env.local" and fill in real values.
# .env.local is gitignored and never committed.
# =============================================================

# Your Resend API key — create a free account at https://resend.com
# Dashboard -> API Keys -> Create. Looks like: re_xxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Where contact-form submissions are delivered (your inbox)
CONTACT_TO_EMAIL=tahmidmahin89@gmail.com

# The "from" address. For quick testing you can use Resend's shared
# sender below. To send from your own domain, verify it in Resend first.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Public site URL (used for SEO metadata, sitemap, robots, OG tags).
# Set this to your real domain in production, e.g. https://tahmidzalal.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: a GitHub personal access token raises the API rate limit for the
# live /api/github stats endpoint. Works without it (60 req/hr per IP).
GITHUB_TOKEN=
